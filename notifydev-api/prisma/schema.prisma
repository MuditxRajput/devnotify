// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  url_table url_table[]
}
model url_table {
  id Int @id @default(autoincrement())
  url String  
  checkInterval Int
  UserId Int
  user User @relation(fields:[UserId],references : [id])
  url_status url_status[]
  consecutiveFailCount Int @default(0)
  consecutiveSuccessCount Int @default(0)
  downNotified Boolean @default(false)
  @@unique([UserId,url])
}
enum status {
  pending
  success
  timeout
  failed
}
model url_status {
  id Int @id @default(autoincrement())
  status status 
  responseTime Int 
  url_tableId Int
  url_table url_table @relation(fields: [url_tableId], references: [id])
  createdAt DateTime @default(now())
}